---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import LogItem from '../components/LogItem.astro';

const logs = (await getCollection('logbook', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="archive" description="complete archive of logbook entries.">
  <div class="flex flex-col w-full gap-10">
    <header>
      <h1 class="type-page-title">archive</h1>
    </header>

    <div class="flex flex-col w-full">
      {logs.map((log) => (
        <LogItem
          title={log.data.title}
          date={log.data.date}
          slug={log.id}
        />
      ))}
    </div>
  </div>
</BaseLayout>
