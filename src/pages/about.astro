---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/site';
---

<BaseLayout title="about" description="about geetansh and this logbook.">
  <div class="flex flex-col w-full gap-8">
    <h1 class="type-page-title">about</h1>

    <div class="prose max-w-none text-[var(--text)]">
      <p>
        hey, i'm geetansh. this is my personal logbook — an engineering notebook where i record research notes, system experiments, and observations on artificial intelligence and software design.
      </p>

      <h2>what this contains</h2>
      <p>
        <strong>logbook:</strong> longer form essays, architecture notes, and technical write-ups.<br />
        <strong>observations:</strong> compact engineering takeaways, heuristics, and field notes.
      </p>

      <h2>connect</h2>
      <p>
        you can visit my main portfolio at <a href="/">geetansh</a>, explore code on <a href="https://github.com/Geetansh-Jangid" target="_blank" rel="noopener noreferrer">github</a>, or subscribe via <a href={withBase('rss.xml')}>rss</a>.
      </p>
    </div>
  </div>
</BaseLayout>
