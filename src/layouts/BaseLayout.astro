---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import MediaLightbox from "../components/MediaLightbox.astro";
import ThemeManager from "../components/ThemeManager.astro";
import { withBase } from "../utils/site";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "geetansh jangid — portfolio",
  description = "developer & researcher building ai systems, bots, and small tools."
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Geetansh Jangid",
  url: "https://geetansh.tech/",
  jobTitle: "Developer",
  description,
  sameAs: [
    "https://github.com/Geetansh-Jangid",
    "https://geetansh.tech/logbook/"
  ]
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#14120B" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Geetansh Jangid" />
    <meta property="og:site_name" content="Geetansh Jangid" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://geetansh.tech/thumb.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://geetansh.tech/thumb.png" />
    <meta name="application-name" content="Geetansh Jangid" />
    <meta name="apple-mobile-web-app-title" content="Geetansh Jangid" />
    <meta name="robots" content="index, follow" />
    <meta name="google-site-verification" content="_jqhdAhRiJvhMh4ff_9Q8yGc469J4TVFHu-KiNSEiiA" />
    <link rel="icon" type="image/svg+xml" href="/logo-dark.svg" id="site-favicon" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Logbook — RSS" href={withBase('rss.xml')} />
    <link rel="alternate" type="application/atom+xml" title="Logbook — Atom" href={withBase('atom.xml')} />
    <link rel="alternate" type="application/feed+json" title="Logbook — JSON Feed" href={withBase('feed.json')} />

    <!-- Preload key self-hosted font files to eliminate layout shift -->
    <link rel="preload" href="/fonts/uncut/woff2/UncutSans-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/uncut/woff2/UncutSans-Medium.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/uncut/woff2/UncutSans-Semibold.woff2" as="font" type="font/woff2" crossorigin />

    <!-- JetBrains Mono preconnect and asynchronous font stylesheet for code -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&display=swap"
        rel="stylesheet"
      />
    </noscript>

    <ThemeManager />
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip-link">skip to content</a>

    <div id="root-container" class="page">
      <Header />
      <main id="main">
        <slot />
      </main>
      <Footer />
    </div>

    <MediaLightbox />
    <div
      id="theme-toast"
      role="status"
      aria-live="polite"
      class="fixed bottom-6 left-1/2 -translate-x-1/2 px-3 py-1.5 text-xs font-mono select-none pointer-events-none opacity-0 transition-opacity duration-200 z-50 rounded-none bg-[var(--surface-2)] text-[var(--text)] border border-[var(--line)] shadow-sm"
    >
    </div>

    <!-- Vercel Web Analytics -->
    <script is:inline>
      window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };
    </script>
    <script is:inline src="/_vercel/insights/script.js"></script>
  </body>
</html>
