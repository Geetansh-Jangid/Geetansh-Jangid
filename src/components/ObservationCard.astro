---
import FormattedDate from './FormattedDate.astro';
import { clsx, getCategoryColor, withBase } from '../utils/site';

interface Props {
  category: string;
  content: string;
  date: Date;
  slug: string;
  index?: number;
}

const { category, content, date, slug, index = 0 } = Astro.props;
---

<a href={withBase(`observations/${slug}/`)} class="block w-full">
  <article
    id={category}
    class={clsx(
      'flex flex-col w-full items-center justify-between gap-3 p-6 relative transition-all duration-150 ease-in-out select-none shadow-xs rounded-none md:rounded-sm',
      getCategoryColor(category),
      index % 2 === 0 ? 'rotate-1 hover:rotate-0' : '-rotate-1 hover:rotate-0'
    )}
  >
    <span class="absolute top-2 right-4 text-4xl md:text-5xl text-gray-800/40 font-serif leading-none select-none pointer-events-none">"</span>
    <h5 class="text-gray-900 dark:text-gray-900 w-full font-medium text-sm">
      geetansh on{' '}
      <span class="underline decoration-wavy">{category}</span>
    </h5>
    <h2 class="text-black dark:text-black font-medium w-full text-xl md:text-2xl indent-9 text-pretty leading-snug my-1">
      {content}
    </h2>
    <p class="text-black/80 dark:text-black/80 w-full text-end font-medium text-xs md:text-sm">
      <FormattedDate date={date} />
    </p>
  </article>
</a>
