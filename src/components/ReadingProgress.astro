<div class="fixed top-0 left-0 right-0 h-0.5 z-50 pointer-events-none" aria-hidden="true">
  <span id="reading-bar" class="block h-full w-full bg-[var(--accent)] origin-left scale-x-0 transition-transform duration-75"></span>
</div>
<script>
  function setupReadingProgress() {
    const bar = document.getElementById('reading-bar');
    if (!bar) return;
    const update = () => {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const progress = max > 0 ? window.scrollY / max : 0;
      bar.style.transform = `scaleX(${Math.min(1, Math.max(0, progress))})`;
    };
    window.addEventListener('scroll', update, { passive: true });
    update();
  }
  setupReadingProgress();
  document.addEventListener('astro:after-swap', setupReadingProgress);
</script>
