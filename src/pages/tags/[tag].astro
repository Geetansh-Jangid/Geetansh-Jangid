---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LogItem from '../../components/LogItem.astro';

export async function getStaticPaths() {
  const posts = await getCollection('logbook', ({ data }) => !data.draft);
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))];
  return tags.map((tag) => ({
    params: { tag: tag.toLowerCase() },
    props: {
      tag,
      posts: posts
        .filter((post) => post.data.tags.some((item) => item.toLowerCase() === tag.toLowerCase()))
        .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()),
    },
  }));
}

const { tag, posts } = Astro.props;
---

<BaseLayout title={`#${tag}`} description={`logs tagged #${tag}`}>
  <div class="flex flex-col w-full gap-10">
    <header>
      <h1 class="type-page-title">#{tag}</h1>
    </header>

    <div class="flex flex-col w-full">
      {posts.map((log) => (
        <LogItem
          title={log.data.title}
          date={log.data.date}
          slug={log.id}
        />
      ))}
    </div>
  </div>
</BaseLayout>
