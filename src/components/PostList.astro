---
import type { CollectionEntry } from 'astro:content';
import WritingItem from './WritingItem.astro';

interface Props {
  posts: CollectionEntry<'logbook'>[];
}

const { posts } = Astro.props;
---

<div class="flex flex-col w-full">
  {posts.map(({ data, id }) => (
    <WritingItem
      title={data.title}
      date={data.date}
      slug={id}
    />
  ))}
</div>
