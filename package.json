{
  "name": "geetansh-jangid-portfolio",
  "private": true,
  "version": "1.0.0",
  "description": "Minimal, text-driven personal portfolio",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n data,astro \"node scripts/generate-data-manifest.js --watch\" \"astro dev --ignore-lock\"",
    "build": "node scripts/generate-data-manifest.js && astro build",
    "preview": "astro preview --ignore-lock",
    "data": "node scripts/generate-data-manifest.js",
    "data:watch": "node scripts/generate-data-manifest.js --watch"
  },
  "dependencies": {
    "@vercel/analytics": "^1.3.1",
    "astro": "^7.4.7"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
