{
  "name": "geetansh-jangid-portfolio",
  "private": true,
  "version": "1.0.0",
  "description": "Minimal, text-driven personal portfolio and logbook",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n data,astro \"node scripts/generate-data-manifest.js --watch\" \"astro dev --ignore-lock --host\"",
    "build": "node scripts/generate-data-manifest.js && astro build",
    "preview": "astro preview --ignore-lock --host",
    "check": "astro check",
    "data": "node scripts/generate-data-manifest.js",
    "data:watch": "node scripts/generate-data-manifest.js --watch"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/markdown-remark": "^7.3.5",
    "@astrojs/rss": "^4.0.12",
    "@astrojs/sitemap": "^3.2.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.4",
    "@types/sanitize-html": "^2.13.0",
    "@vercel/analytics": "^1.3.1",
    "astro": "^7.4.7",
    "katex": "^0.19.1",
    "marked": "^15.0.7",
    "mermaid": "^12.3.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "sanitize-html": "^2.14.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
