---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { clsx, getCategoryColor, withBase } from '../../utils/site';

export async function getStaticPaths() {
  const observations = await getCollection('observations', ({ data }) => !data.draft);
  return observations.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { data } = entry;
---

<BaseLayout
  title={`observation on ${data.category}`}
  description={data.description}
>
  <div class="flex flex-col w-full gap-8">
    <div>
      <a
        href={withBase('observations/')}
        class="text-sm font-medium text-[var(--color-text-secondary)] hover:text-[var(--color-text)] transition-colors inline-flex items-center gap-1.5 no-underline hover:underline"
      >
        <span>←</span> back to observations
      </a>
    </div>

    <!-- Observation Hero Quote Card -->
    <article
      id={data.category}
      class={clsx(
        'flex flex-col w-full items-center justify-between gap-4 p-8 relative shadow-sm rounded-none md:rounded-sm select-none',
        getCategoryColor(data.category)
      )}
    >
      <span class="absolute top-3 right-5 text-5xl md:text-6xl text-gray-800/40 font-serif leading-none select-none pointer-events-none">"</span>
      <h5 class="text-gray-900 dark:text-gray-900 w-full font-medium text-sm">
        geetansh on{' '}
        <span class="underline decoration-wavy">{data.category}</span>
      </h5>
      <h1 class="text-black dark:text-black font-medium w-full text-2xl md:text-3xl indent-10 text-pretty leading-snug my-2">
        {data.description}
      </h1>
      <p class="text-black/80 dark:text-black/80 w-full text-end font-medium text-xs md:text-sm">
        <FormattedDate date={data.date} />
      </p>
    </article>

    <!-- Observation Extended Commentary -->
    <div class="prose max-w-none w-full text-[var(--color-text-body)]">
      <Content />
    </div>

    <div class="pt-8 mt-4">
      <a
        href={withBase('observations/')}
        class="text-sm font-medium text-[var(--color-text-secondary)] hover:text-[var(--color-text)] transition-colors inline-flex items-center gap-1.5 no-underline hover:underline"
      >
        <span>←</span> view all observations
      </a>
    </div>
  </div>
</BaseLayout>
