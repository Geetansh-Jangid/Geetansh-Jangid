---
import { getCollection } from 'astro:content';
import { withBase } from '../../utils/site';

export async function getStaticPaths() {
  const thoughts = await getCollection('observations', ({ data }) => !data.draft);
  return thoughts.map((entry) => ({ params: { slug: entry.id } }));
}

const { slug } = Astro.params;
return Astro.redirect(withBase(`observations/${slug}/`));
---
