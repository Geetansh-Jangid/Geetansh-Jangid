---
import HeaderLink from "./HeaderLink.astro";
import ThemeToggle from "./ThemeToggle.astro";

const menuItems = [
  { label: "geetansh", url: "/" },
  { label: "logbook", url: "/logbook/" },
  { label: "observations", url: "/observations/", class: "nav-observations" },
];
---

<header class="site-header">
  <nav aria-label="Main navigation">
    {menuItems.map((item) => (
      <HeaderLink href={item.url} class={item.class}>
        {item.label}
      </HeaderLink>
    ))}
  </nav>
  <ThemeToggle />
</header>
